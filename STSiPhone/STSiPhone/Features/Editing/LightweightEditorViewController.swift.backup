    // MARK: - TrimmerViewDelegate Methods (COMPLETE IMPLEMENTATION)
    
    // Track previous trim range to detect handle movements
    private var lastTrimStartTime: CMTime?
    private var lastTrimEndTime: CMTime?
    
    private func onTrimmerRangeChanged(_ range: CMTimeRange) {
        DispatchQueue.main.async {
            guard range.duration.seconds.isFinite, range.duration.seconds > 0 else { return }
            print("🔄 DEBUG onTrimmerRangeChanged fired – duration: \(range.duration.seconds)s")
            self.hasPendingTrimChanges = true
            self.pendingTrimRange = range
            
            self.trimHud.text = String(format: "  %02d:%02d  ",
                                       Int(range.duration.seconds) / 60,
                                       Int(range.duration.seconds) % 60)
            if self.trimHud.isHidden {
                self.trimHud.alpha = 0
                self.trimHud.isHidden = false
                UIView.animate(withDuration: 0.15) { self.trimHud.alpha = 1 }
            }
            
            // CRITICAL FIX: Toolbar should always exist by now
            self.updateToolbarForPendingTrim(true)
        }
    }
    
    // MARK: - TrimmerViewDelegate Methods (CLEAN NATIVE IMPLEMENTATION)
    
    func didChangePositionBar(_ playerTime: CMTime) {
        print("🎯 CLEAN DELEGATE: didChangePositionBar fired with time \(playerTime.seconds)s")
        
        // CLEAN: Simple handle movement detection without complex state tracking
        if let currentStartTime = trimmerView?.startTime,
           let currentEndTime = trimmerView?.endTime {
            
            // Check if this is a handle movement (startTime/endTime changed significantly)
            let startTimeChanged = lastTrimStartTime == nil ||
                                 abs(currentStartTime.seconds - (lastTrimStartTime?.seconds ?? 0)) > 0.01
            let endTimeChanged = lastTrimEndTime == nil ||
                               abs(currentEndTime.seconds - (lastTrimEndTime?.seconds ?? 0)) > 0.01
            
            if startTimeChanged || endTimeChanged {
                print("✂️ CLEAN TRIM CHANGE: Handle moved - start=\(currentStartTime.seconds)s, end=\(currentEndTime.seconds)s")
                
                // Create range and show Apply/Cancel
                let range = CMTimeRange(start: currentStartTime, duration: CMTimeSubtract(currentEndTime, currentStartTime))
                hasPendingTrimChanges = true
                pendingTrimRange = range
                updateToolbarForPendingTrim(true)
                
                // Update tracking
                lastTrimStartTime = currentStartTime
                lastTrimEndTime = currentEndTime
                
                // 🚫 REMOVED: Force seeking that was conflicting with native behavior
                // Let native trimmer handle player synchronization automatically
                print("✅ NATIVE SYNC: Letting native trimmer handle player synchronization")
            }
        }
        
        // CLEAN: Update displays
        updateTimecodeDisplays()
    }
    
    func positionBarStoppedMoving(_ playerTime: CMTime) {
        print("🎯 CLEAN DELEGATE: positionBarStoppedMoving fired")
        // Clean implementation - just update displays
        updateTimecodeDisplays()
    }
    
    // MARK: - Playback Monitoring
    
    // MARK: - REMOVED: Complex Playback Monitoring Systems
    // These methods have been removed - native PryntTrimmerView handles synchronization
    // private func startPlaybackTimeChecker() { ... }
    // private func stopPlaybackTimeChecker() { ... }
    // private func updatePlaybackTimeChecker() { ... }
    // Native trimmer delegates provide all needed position updates
    
    private func addPeriodicTimeObserver() {
        print("⏱️ TIME OBSERVER: Adding periodic time observer for trimmer sync")
        
        removePeriodicTimeObserverIfNeeded()
        guard let player = player else { return }
        
        let timeScale = CMTimeScale(NSEC_PER_SEC)
        let time = CMTime(seconds: 0.1, preferredTimescale: timeScale)
        
        timeObserver = player.addPeriodicTimeObserver(forInterval: time, queue: .main) { [weak self] time in
            self?.handlePeriodicTimeUpdate(time)
        }
        timeObserverOwner = player
    }
    
    private func removePeriodicTimeObserverIfNeeded() {
        if let observer = timeObserver, let owner = timeObserverOwner {
            owner.removeTimeObserver(observer)
            timeObserver = nil
            timeObserverOwner = nil
            print("⏱️ TIME OBSERVER: Removed safely from owning player")
        }
    }
    
    private func handlePeriodicTimeUpdate(_ time: CMTime) {
        // CLEAN: Only update time display - let native trimmer handle position bar
        currentTimeLabel.text = formatTime(time)
        
        // 🚫 REMOVED: Manual trimmer sync that was conflicting with native behavior
        // Old code: if !hasPendingTrimChanges { trimmerView?.seek(to: time) }
        // Native trimmer should handle its own position bar updates
        
        // Only update our separate timecode displays (not the trimmer itself)
        if !hasPendingTrimChanges {
            updateTimecodeDisplays()
        }
    }
    
    @objc private func itemDidFinishPlaying(_ notification: Notification) {
        print("🎬 PLAYBACK: Video finished playing")
        
        // 🎬 ONLY control the player - let native trimmer sync itself
        player?.pause()
        player?.seek(to: .zero, toleranceBefore: .zero, toleranceAfter: .zero, completionHandler: { _ in })
        
        // 🚫 REMOVED: Manual trimmer sync - let native handle this
        // Old code: trimmerView.seek(to: .zero)
        
        // IMPORTANT: Update button when video finishes
        updatePlayPauseButton()
        updateTimecodeDisplays()
        
        print("✅ NATIVE SYNC: Player reset to beginning - native trimmer will sync automatically")
    }
    
    // MARK: - Toolbar Setup
    
    internal func updateToolbarForPendingTrim(_ showApplyCancel: Bool) {
        print("🔄 DEBUG updateToolbarForPendingTrim: showApplyCancel=\(showApplyCancel)")
        
        guard let toolbar = toolbar else {
            print("🚨 CRITICAL ERROR: Toolbar should exist by now!")
            return
        }
        
        if showApplyCancel {
            guard let applyButton = applyTrimButton,
                  let cancelButton = cancelTrimButton else {
                print("🚨 CRITICAL ERROR: Apply/Cancel buttons not initialized!")
                return
            }
            
            let flexibleSpace = UIBarButtonItem(barButtonSystemItem: .flexibleSpace, target: nil, action: nil)
            let fixedSpace = UIBarButtonItem(barButtonSystemItem: .fixedSpace, target: nil, action: nil)
            fixedSpace.width = 20
            
            toolbar.items = [
                flexibleSpace,
                cancelButton,
                fixedSpace,
                applyButton,
                flexibleSpace
            ]
            toolbarMode = .pendingTrim
            view.bringSubviewToFront(toolbar)
            
            print("✅ TOOLBAR SUCCESS: Showing Apply/Cancel buttons for pending trim")
        } else {
            recreateDefaultToolbarItems()
            updatePlayPauseButton()
            toolbarMode = .normal
            view.bringSubviewToFront(toolbar)
            
            print("✅ TOOLBAR: Restored to normal mode")
        }
    }
    
