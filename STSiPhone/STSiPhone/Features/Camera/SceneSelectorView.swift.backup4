import SwiftUI

struct SceneSelectorView: View {
    @ObservedObject var sessionManager = SessionManager.shared

    // Callback for "That's a Wrap"
    var onComplete: (() -> Void)?

    init(onComplete: (() -> Void)? = nil) {
        self.onComplete = onComplete
    }

    var body: some View {
        // Use VStack for portrait, HStack for landscape
        GeometryReader { geometry in
            let isPortrait = geometry.size.width < geometry.size.height
            
            if isPortrait {
                VStack(spacing: 8) {
                    // First row: Scene and Slate
                    HStack(spacing: 8) {
                        sceneControlForPortrait
                        slateButtonForPortrait
                    }
                    
                    // Second row: Keyframe and Wrap
                    HStack(spacing: 8) {
                        keyframeButtonForPortrait
                        wrapButtonForPortrait
                    }
                }
                .padding(.horizontal, 8)
                .padding(.vertical, 8)
                .background(.ultraThinMaterial.opacity(0.9), in: RoundedRectangle(cornerRadius: 16))
            } else {
                // Landscape: Original horizontal layout
                HStack(spacing: 8) {
                    sceneControl
                    
                    pillButton(
                        title: "Slate",
                        systemImage: "tv",
                        isDone: slateDone,
                        isActive: sessionManager.isRecordingSlate
                    ) {
                        sessionManager.switchToSlateMode()
                    }

                    pillButton(
                        title: "Keyframe",
                        systemImage: "camera.fill",
                        isDone: keyframeDone,
                        isActive: sessionManager.isRecordingKeyframePhoto
                    ) {
                        sessionManager.switchToKeyframePhotoMode()
                    }

                    pillButton(
                        title: "Wrap",
                        systemImage: "flag.checkered",
                        isDone: hasAnyTakes,
                        isActive: false
                    ) {
                        onComplete?()
                    }
                }
                .padding(.horizontal, 8)
                .padding(.vertical, 6)
                .background(.ultraThinMaterial.opacity(0.9), in: Capsule())
            }
        }
        .frame(height: 80) // Fixed height to prevent layout jumping
    }

    // MARK: - Portrait-optimized controls
    @ViewBuilder
    private var sceneControlForPortrait: some View {
        let title = "Scene \(sessionManager.currentScene)"
        let isSceneActive = !sessionManager.isRecordingSlate && !sessionManager.isRecordingKeyframePhoto
        
        if sessionManager.totalScenes > 1 {
            Menu {
                ForEach(1...sessionManager.totalScenes, id: \.self) { sceneNumber in
                    Button {
                        sessionManager.switchToScene(sceneNumber)
                        sessionManager.switchToSceneMode()
                    } label: {
                        HStack {
                            Label("Scene \(sceneNumber)",
                                  systemImage: sceneNumber == sessionManager.currentScene ? "checkmark" : "video.fill")
                            Spacer()
                            let count = sessionManager.getTakesForScene(sceneNumber).count
                            if count > 0 {
                                Text("(\(count))").font(.caption).foregroundStyle(.secondary)
                            }
                        }
                    }
                }
            } label: {
                portraitPillLabel(title: title, systemImage: "video.fill", isDone: sceneHasVideo, isActive: isSceneActive)
            }
        } else {
            Button {
                sessionManager.switchToSceneMode()
            } label: {
                portraitPillLabel(title: title, systemImage: "video.fill", isDone: sceneHasVideo, isActive: isSceneActive)
            }
        }
    }
    
    private var slateButtonForPortrait: some View {
        Button(action: {
            UIImpactFeedbackGenerator(style: .light).impactOccurred()
            sessionManager.switchToSlateMode()
        }) {
            portraitPillLabel(
                title: "Slate",
                systemImage: "tv",
                isDone: slateDone,
                isActive: sessionManager.isRecordingSlate
            )
        }
        .buttonStyle(.plain)
    }
    
    private var keyframeButtonForPortrait: some View {
        Button(action: {
            UIImpactFeedbackGenerator(style: .light).impactOccurred()
            sessionManager.switchToKeyframePhotoMode()
        }) {
            portraitPillLabel(
                title: "Photo",
                systemImage: "camera.fill",
                isDone: keyframeDone,
                isActive: sessionManager.isRecordingKeyframePhoto
            )
        }
        .buttonStyle(.plain)
    }
    
    private var wrapButtonForPortrait: some View {
        Button(action: {
            UIImpactFeedbackGenerator(style: .light).impactOccurred()
            onComplete?()
        }) {
            portraitPillLabel(
                title: "Wrap",
                systemImage: "flag.checkered",
                isDone: hasAnyTakes,
                isActive: false
            )
        }
        .buttonStyle(.plain)
    }

    // MARK: - Portrait pill design
    private func portraitPillLabel(title: String, systemImage: String, isDone: Bool, isActive: Bool = false) -> some View {
        VStack(spacing: 4) {
            Image(systemName: systemImage)
                .font(.title2)
                .imageScale(.medium)
            
            Text(title)
                .font(.system(size: 12, weight: .semibold))
                .lineLimit(1)
                .minimumScaleFactor(0.8)
        }
        .frame(maxWidth: .infinity)
        .frame(height: 50)
        .foregroundColor(isActive ? .white : .primary)
        .background(
            isActive ? 
                Color.blue.opacity(0.8) :
            isDone ? 
                Color.green.opacity(0.28) : 
                Color.secondary.opacity(0.15)
        )
        .overlay(
            RoundedRectangle(cornerRadius: 12).stroke(
                isActive ? 
                    Color.white.opacity(0.6) :
                isDone ? 
                    Color.green : 
                    Color.white.opacity(0.25), 
                lineWidth: isActive ? 1.5 : 1
            )
        )
        .clipShape(RoundedRectangle(cornerRadius: 12))
        .scaleEffect(isActive ? 1.05 : 1.0)
        .animation(.easeInOut(duration: 0.2), value: isActive)
    }

    // MARK: - Original landscape scene control
    @ViewBuilder
    private var sceneControl: some View {
        let title = "Scene \(sessionManager.currentScene)"
        let isSceneActive = !sessionManager.isRecordingSlate && !sessionManager.isRecordingKeyframePhoto
        
        if sessionManager.totalScenes > 1 {
            Menu {
                ForEach(1...sessionManager.totalScenes, id: \.self) { sceneNumber in
                    Button {
                        sessionManager.switchToScene(sceneNumber)
                        sessionManager.switchToSceneMode()
                    } label: {
                        HStack {
                            Label("Scene \(sceneNumber)",
                                  systemImage: sceneNumber == sessionManager.currentScene ? "checkmark" : "video.fill")
                            Spacer()
                            let count = sessionManager.getTakesForScene(sceneNumber).count
                            if count > 0 {
                                Text("(\(count))").font(.caption).foregroundStyle(.secondary)
                            }
                        }
                    }
                }
            } label: {
                pillLabel(title: title, systemImage: "video.fill", isDone: sceneHasVideo, isActive: isSceneActive)
            }
        } else {
            Button {
                sessionManager.switchToSceneMode()
            } label: {
                pillLabel(title: title, systemImage: "video.fill", isDone: sceneHasVideo, isActive: isSceneActive)
            }
        }
    }

    // MARK: - Original landscape pills
    private func pillButton(title: String, systemImage: String, isDone: Bool, isActive: Bool, action: @escaping () -> Void) -> some View {
        Button(action: {
            UIImpactFeedbackGenerator(style: .light).impactOccurred()
            action()
        }) {
            pillLabel(title: title, systemImage: systemImage, isDone: isDone, isActive: isActive)
        }
        .buttonStyle(.plain)
    }

    private func pillLabel(title: String, systemImage: String, isDone: Bool, isActive: Bool = false) -> some View {
        HStack(spacing: 6) {
            Image(systemName: systemImage).imageScale(.medium)
            Text(title)
                .font(.system(size: 14, weight: .semibold))
                .lineLimit(1)
                .minimumScaleFactor(0.8)
        }
        .padding(.horizontal, 10)
        .padding(.vertical, 7)
        .foregroundColor(isActive ? .white : .primary)
        .background(
            isActive ? 
                Color.blue.opacity(0.8) :
            isDone ? 
                Color.green.opacity(0.28) : 
                Color.secondary.opacity(0.15)
        )
        .overlay(
            Capsule().stroke(
                isActive ? 
                    Color.white.opacity(0.6) :
                isDone ? 
                    Color.green : 
                    Color.white.opacity(0.25), 
                lineWidth: isActive ? 1.5 : 1
            )
        )
        .clipShape(Capsule())
        .scaleEffect(isActive ? 1.05 : 1.0)
        .animation(.easeInOut(duration: 0.2), value: isActive)
    }

    // MARK: - Progress flags
    private var sceneHasVideo: Bool {
        !sessionManager.getTakesForScene(sessionManager.currentScene).isEmpty
    }

    private var slateDone: Bool {
        sessionManager.hasRecordedSlate || !sessionManager.getSlateTakesAsTakes().isEmpty
    }

    private var keyframeDone: Bool {
        sessionManager.hasRecordedKeyframePhoto || !sessionManager.getKeyframePhotoTakesAsTakes().isEmpty
    }

    private var hasAnyTakes: Bool {
        !sessionManager.unifiedTakes.isEmpty || !sessionManager.takes.isEmpty
    }
}

#Preview {
    SceneSelectorView()
        .background(.black)
        .onAppear {
            SessionManager.shared.totalScenes = 3
            SessionManager.shared.currentScene = 2
        }
}
