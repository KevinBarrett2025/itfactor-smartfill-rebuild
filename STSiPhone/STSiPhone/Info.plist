	<string>Self Tape Studio needs the camera to record your audition.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Self Tape Studio uses the microphone to capture your performance audio.</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackgroundColor</string>
